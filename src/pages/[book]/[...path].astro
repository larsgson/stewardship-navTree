---
import BaseLayout from "../../layouts/BaseLayout.astro"
import PageReaderIsland from "../../components/PageReaderIsland"
import PageNavigationIsland from "../../components/PageNavigationIsland"
import V2PageContent from "../../components/V2PageContent"
import {
  discoverBooks,
  loadBookStructure,
  loadLocaleData,
  loadMarkdownContent,
  loadAllPageTimings,
  loadCombinedTiming,
  discoverLocales,
  isV1Book,
  ROOT_BOOK_ID,
  bookBasePath,
} from "../../lib/book-loader"
import {
  isV2Book,
  loadV2BookData,
  loadV2Content,
  loadV2Markdown,
  contentBlocksToSections,
  buildNavOrder,
  buildWikiLinkMap,
  resolveWikiLinks,
  findV2Node,
  resolveV2NodeTitle,
  resolveV2Redirect,
  stripFrontmatter,
} from "../../lib/v2-loader"
import { parseMarkdownIntoSections } from "../../lib/markdown-parser"

export function getStaticPaths() {
  const bookIds = discoverBooks().filter((id) => id !== ROOT_BOOK_ID)
  const paths: any[] = []

  for (const id of bookIds) {
    if (isV1Book(id)) {
      const structure = loadBookStructure(id)
      if (!structure) continue
      const locales = discoverLocales(id)
      const locale = locales.length > 0 ? loadLocaleData(id, locales[0]) : null

      for (const cat of structure.categories) {
        if (structure.categories.length > 1) {
          paths.push({
            params: { book: id, path: cat.id },
            props: {
              format: "v1" as const,
              pageType: "category" as const,
              bookId: id,
              structure,
              categoryId: cat.id,
              localeData: locale,
            },
          })
        }

        const allPageIds = cat.stories.map((s) => s.id)
        const isSingleStory = cat.stories.length === 1

        let allTimings: Record<string, import("../../lib/types").PageTiming>
        if (isSingleStory) {
          const combined = loadCombinedTiming(id, cat.id)
          allTimings = { [cat.stories[0].id]: combined }
        } else {
          allTimings = loadAllPageTimings(id, cat.id, allPageIds)
        }

        for (let i = 0; i < cat.stories.length; i++) {
          const page = cat.stories[i]
          const prevPage = i > 0 ? cat.stories[i - 1] : null
          const nextPage = i < cat.stories.length - 1 ? cat.stories[i + 1] : null

          paths.push({
            params: { book: id, path: `${cat.id}/${page.id}` },
            props: {
              format: "v1" as const,
              pageType: "story" as const,
              bookId: id,
              categoryId: cat.id,
              pageId: page.id,
              localeData: locale,
              markdownContent: loadMarkdownContent(id, cat.id, page.id) || "",
              imageConfig: structure.imageConfig,
              audioUrl: cat.audioUrl,
              allTimings,
              allPageIds,
              prevPageUrl: prevPage ? `/${id}/${cat.id}/${prevPage.id}` : null,
              nextPageUrl: nextPage ? `/${id}/${cat.id}/${nextPage.id}` : null,
              currentPageNumber: i + 1,
              totalPages: cat.stories.length,
            },
          })
        }
      }

      continue
    }

    if (isV2Book(id)) {
      const bookData = loadV2BookData(id)
      if (!bookData) continue

      const navOrder = buildNavOrder(bookData.roots)
      const lang = bookData.config.defaultLanguage
      const base = bookBasePath(id)
      const linkMap = buildWikiLinkMap(bookData.roots, base)

      for (let i = 0; i < navOrder.length; i++) {
        const node = navOrder[i]
        const resolved = resolveV2Redirect(id, node, bookData.roots)
        const title = resolveV2NodeTitle(node, lang)

        const contentBlocks = loadV2Content(id, resolved.folderPath)
        const rawMarkdown = contentBlocks ? null : loadV2Markdown(id, resolved.folderPath)

        let parsed = { title, sections: [] as any[] }
        let markdown: string | undefined
        if (contentBlocks) {
          parsed = contentBlocksToSections(contentBlocks, title)
        } else if (rawMarkdown) {
          markdown = resolveWikiLinks(stripFrontmatter(rawMarkdown), linkMap)
        }

        const prevNode = i > 0 ? navOrder[i - 1] : null
        const nextNode = i < navOrder.length - 1 ? navOrder[i + 1] : null

        paths.push({
          params: { book: id, path: node.folderPath },
          props: {
            format: "v2" as const,
            bookId: id,
            folderPath: node.folderPath,
            title,
            parsed,
            markdown,
            imageConfig: bookData.imageConfig,
            childNodes: node.children,
            prevUrl: prevNode ? `${base}/${prevNode.folderPath}` : null,
            nextUrl: nextNode ? `${base}/${nextNode.folderPath}` : null,
            lang,
          },
        })
      }
    }
  }

  return paths
}

const props = Astro.props
const pageTitle = props.format === "v1"
  ? (props.localeData?.bookTitle || props.bookId)
  : props.title
---

<BaseLayout title={pageTitle}>
  {props.format === "v1" && props.pageType === "category" ? (
    <div class="max-w-sm mx-auto p-4">
      <PageNavigationIsland
        client:load
        bookId={props.bookId}
        structure={props.structure}
        localeData={props.localeData}
        imageConfig={props.structure.imageConfig}
        defaultCategoryId={props.categoryId}
      />
    </div>
  ) : props.format === "v1" ? (
    <div class="max-w-sm mx-auto p-4">
      <PageReaderIsland
        client:load
        bookId={props.bookId}
        categoryId={props.categoryId}
        pageId={props.pageId}
        markdownContent={props.markdownContent}
        localeData={props.localeData}
        imageConfig={props.imageConfig}
        audioUrl={props.audioUrl}
        allTimings={props.allTimings}
        allPageIds={props.allPageIds}
        prevPageUrl={props.prevPageUrl}
        nextPageUrl={props.nextPageUrl}
        currentPageNumber={props.currentPageNumber}
        totalPages={props.totalPages}
      />
    </div>
  ) : (
    <div class="max-w-sm mx-auto p-4">
      <V2PageContent
        client:load
        basePath={bookBasePath(props.bookId)}
        folderPath={props.folderPath}
        title={props.title}
        parsed={props.parsed}
        markdown={props.markdown}
        imageConfig={props.imageConfig}
        childNodes={props.childNodes}
        prevUrl={props.prevUrl}
        nextUrl={props.nextUrl}
        lang={props.lang}
      />
    </div>
  )}
</BaseLayout>
