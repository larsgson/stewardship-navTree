---
import BaseLayout from "../layouts/BaseLayout.astro"
import BookGridIsland from "../components/BookGridIsland"
import SidebarNav from "../components/SidebarNav"
import MenuButton from "../components/MenuButton.astro"
import { discoverBooks, loadBookStructure, loadLocaleData, discoverLocales, isV1Book, ROOT_BOOK_ID, bookBasePath } from "../lib/book-loader"
import { isV2Book, loadV2BookData } from "../lib/v2-loader"
import { loadAppConfig } from "../lib/app-config"

const appConfig = loadAppConfig()
const bookIds = discoverBooks()
const currentPath = Astro.url.pathname

const isRootBook = bookIds.length === 1 && bookIds[0] === ROOT_BOOK_ID

let rootBookData: ReturnType<typeof loadV2BookData> = null
if (isRootBook && isV2Book(ROOT_BOOK_ID)) {
  rootBookData = loadV2BookData(ROOT_BOOK_ID)
}

const bookList = isRootBook ? [] : bookIds.map((id) => {
  if (isV1Book(id)) {
    const structure = loadBookStructure(id)
    if (!structure) return null
    const locales = discoverLocales(id)
    const locale = locales.length > 0 ? loadLocaleData(id, locales[0]) : null
    const pageCount = structure.categories.reduce((sum, c) => sum + c.stories.length, 0)
    return {
      id,
      title: locale?.bookTitle || id,
      description: locale?.categories?.[structure.categories[0]?.id]?.description || "",
      coverImage: structure.coverImage,
      categoryCount: structure.categories.length,
      pageCount,
      imageConfig: structure.imageConfig,
    }
  }

  if (isV2Book(id)) {
    const bookData = loadV2BookData(id)
    if (!bookData) return null
    function countNodes(nodes: typeof bookData.roots): number {
      return nodes.reduce((sum, n) => sum + 1 + countNodes(n.children), 0)
    }
    return {
      id,
      title: bookData.config.projectName,
      description: "",
      coverImage: "",
      categoryCount: bookData.roots.length,
      pageCount: countNodes(bookData.roots),
      imageConfig: bookData.imageConfig,
    }
  }

  return null
}).filter(Boolean) as any[]
---

<BaseLayout title={appConfig.appName}>
  {rootBookData && <MenuButton slot="menu-button" />}
  {rootBookData && (
    <SidebarNav
      slot="sidebar"
      client:load
      title={appConfig.appName}
      nodes={rootBookData.roots}
      basePath=""
      currentPath={currentPath}
      lang={rootBookData.config.defaultLanguage}
      transition:persist="sidebar"
    />
  )}

  {rootBookData ? (
    <Fragment>
      <h1 class="text-2xl font-bold mb-6">{appConfig.appName}</h1>
      <p class="text-gray-500">Select a topic from the sidebar to get started.</p>
    </Fragment>
  ) : (
    <Fragment>
      <h1 class="text-2xl font-bold mb-6">{appConfig.appName}</h1>
      <BookGridIsland client:load books={bookList} />
    </Fragment>
  )}
</BaseLayout>
